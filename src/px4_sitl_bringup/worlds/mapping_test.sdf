<?xml version="1.0" encoding="UTF-8"?>
<sdf version="1.9">
  <world name="mapping_test">
    <!-- Match PX4 v1.17's default Gazebo physics settings. -->
    <physics type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>

    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type="adiabatic"/>

    <scene>
      <grid>true</grid>
      <ambient>0.45 0.45 0.45 1</ambient>
      <background>0.72 0.78 0.82 1</background>
      <shadows>true</shadows>
    </scene>

    <model name="ground_plane">
      <static>true</static>
      <link name="ground_link">
        <collision name="ground_collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>50 50</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode/>
            </friction>
            <bounce/>
            <contact/>
          </surface>
        </collision>

        <visual name="ground_visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>50 50</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.32 0.36 0.34 1</ambient>
            <diffuse>0.42 0.48 0.44 1</diffuse>
            <specular>0.08 0.08 0.08 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!--
      All obstacles share one static link. Each collision has a matching visual
      at the same pose and size so the LiDAR sees the geometry shown in Gazebo.
    -->
    <model name="mapping_geometry">
      <static>true</static>
      <link name="obstacles">
        <!-- Perimeter walls: a 30 m by 30 m flying area. -->
        <collision name="north_wall_collision">
          <pose>0 15 2 0 0 0</pose>
          <geometry><box><size>30 0.4 4</size></box></geometry>
        </collision>
        <visual name="north_wall_visual">
          <pose>0 15 2 0 0 0</pose>
          <geometry><box><size>30 0.4 4</size></box></geometry>
          <material>
            <ambient>0.35 0.38 0.42 1</ambient>
            <diffuse>0.55 0.58 0.62 1</diffuse>
          </material>
        </visual>

        <collision name="south_wall_collision">
          <pose>0 -15 2 0 0 0</pose>
          <geometry><box><size>30 0.4 4</size></box></geometry>
        </collision>
        <visual name="south_wall_visual">
          <pose>0 -15 2 0 0 0</pose>
          <geometry><box><size>30 0.4 4</size></box></geometry>
          <material>
            <ambient>0.35 0.38 0.42 1</ambient>
            <diffuse>0.55 0.58 0.62 1</diffuse>
          </material>
        </visual>

        <collision name="east_wall_collision">
          <pose>15 0 2 0 0 0</pose>
          <geometry><box><size>0.4 30 4</size></box></geometry>
        </collision>
        <visual name="east_wall_visual">
          <pose>15 0 2 0 0 0</pose>
          <geometry><box><size>0.4 30 4</size></box></geometry>
          <material>
            <ambient>0.35 0.38 0.42 1</ambient>
            <diffuse>0.55 0.58 0.62 1</diffuse>
          </material>
        </visual>

        <collision name="west_wall_collision">
          <pose>-15 0 2 0 0 0</pose>
          <geometry><box><size>0.4 30 4</size></box></geometry>
        </collision>
        <visual name="west_wall_visual">
          <pose>-15 0 2 0 0 0</pose>
          <geometry><box><size>0.4 30 4</size></box></geometry>
          <material>
            <ambient>0.35 0.38 0.42 1</ambient>
            <diffuse>0.55 0.58 0.62 1</diffuse>
          </material>
        </visual>

        <!-- Interior room in the northeast, with a west-facing doorway. -->
        <collision name="room_north_collision">
          <pose>8 9.5 1.5 0 0 0</pose>
          <geometry><box><size>6 0.3 3</size></box></geometry>
        </collision>
        <visual name="room_north_visual">
          <pose>8 9.5 1.5 0 0 0</pose>
          <geometry><box><size>6 0.3 3</size></box></geometry>
          <material>
            <ambient>0.22 0.36 0.46 1</ambient>
            <diffuse>0.32 0.56 0.70 1</diffuse>
          </material>
        </visual>

        <collision name="room_south_collision">
          <pose>8 2.5 1.5 0 0 0</pose>
          <geometry><box><size>6 0.3 3</size></box></geometry>
        </collision>
        <visual name="room_south_visual">
          <pose>8 2.5 1.5 0 0 0</pose>
          <geometry><box><size>6 0.3 3</size></box></geometry>
          <material>
            <ambient>0.22 0.36 0.46 1</ambient>
            <diffuse>0.32 0.56 0.70 1</diffuse>
          </material>
        </visual>

        <collision name="room_east_collision">
          <pose>11 6 1.5 0 0 0</pose>
          <geometry><box><size>0.3 7 3</size></box></geometry>
        </collision>
        <visual name="room_east_visual">
          <pose>11 6 1.5 0 0 0</pose>
          <geometry><box><size>0.3 7 3</size></box></geometry>
          <material>
            <ambient>0.22 0.36 0.46 1</ambient>
            <diffuse>0.32 0.56 0.70 1</diffuse>
          </material>
        </visual>

        <collision name="room_west_north_collision">
          <pose>5 8.25 1.5 0 0 0</pose>
          <geometry><box><size>0.3 2.5 3</size></box></geometry>
        </collision>
        <visual name="room_west_north_visual">
          <pose>5 8.25 1.5 0 0 0</pose>
          <geometry><box><size>0.3 2.5 3</size></box></geometry>
          <material>
            <ambient>0.22 0.36 0.46 1</ambient>
            <diffuse>0.32 0.56 0.70 1</diffuse>
          </material>
        </visual>

        <collision name="room_west_south_collision">
          <pose>5 3.75 1.5 0 0 0</pose>
          <geometry><box><size>0.3 2.5 3</size></box></geometry>
        </collision>
        <visual name="room_west_south_visual">
          <pose>5 3.75 1.5 0 0 0</pose>
          <geometry><box><size>0.3 2.5 3</size></box></geometry>
          <material>
            <ambient>0.22 0.36 0.46 1</ambient>
            <diffuse>0.32 0.56 0.70 1</diffuse>
          </material>
        </visual>

        <!-- A three-sided alcove, open toward the takeoff area. -->
        <collision name="alcove_back_collision">
          <pose>-12 4 1.5 0 0 0</pose>
          <geometry><box><size>0.3 6 3</size></box></geometry>
        </collision>
        <visual name="alcove_back_visual">
          <pose>-12 4 1.5 0 0 0</pose>
          <geometry><box><size>0.3 6 3</size></box></geometry>
          <material>
            <ambient>0.48 0.32 0.20 1</ambient>
            <diffuse>0.68 0.48 0.28 1</diffuse>
          </material>
        </visual>

        <collision name="alcove_north_collision">
          <pose>-10 7 1.5 0 0 0</pose>
          <geometry><box><size>4 0.3 3</size></box></geometry>
        </collision>
        <visual name="alcove_north_visual">
          <pose>-10 7 1.5 0 0 0</pose>
          <geometry><box><size>4 0.3 3</size></box></geometry>
          <material>
            <ambient>0.48 0.32 0.20 1</ambient>
            <diffuse>0.68 0.48 0.28 1</diffuse>
          </material>
        </visual>

        <collision name="alcove_south_collision">
          <pose>-10 1 1.5 0 0 0</pose>
          <geometry><box><size>4 0.3 3</size></box></geometry>
        </collision>
        <visual name="alcove_south_visual">
          <pose>-10 1 1.5 0 0 0</pose>
          <geometry><box><size>4 0.3 3</size></box></geometry>
          <material>
            <ambient>0.48 0.32 0.20 1</ambient>
            <diffuse>0.68 0.48 0.28 1</diffuse>
          </material>
        </visual>

        <!-- Height and shape variation for recognizable LiDAR geometry. -->
        <collision name="low_barrier_collision">
          <pose>0 -8 0.5 0 0 0</pose>
          <geometry><box><size>5 0.5 1</size></box></geometry>
        </collision>
        <visual name="low_barrier_visual">
          <pose>0 -8 0.5 0 0 0</pose>
          <geometry><box><size>5 0.5 1</size></box></geometry>
          <material>
            <ambient>0.55 0.46 0.12 1</ambient>
            <diffuse>0.82 0.70 0.18 1</diffuse>
          </material>
        </visual>

        <collision name="box_pillar_collision">
          <pose>7 -7 2 0 0 0</pose>
          <geometry><box><size>1.5 1.5 4</size></box></geometry>
        </collision>
        <visual name="box_pillar_visual">
          <pose>7 -7 2 0 0 0</pose>
          <geometry><box><size>1.5 1.5 4</size></box></geometry>
          <material>
            <ambient>0.38 0.18 0.18 1</ambient>
            <diffuse>0.68 0.28 0.26 1</diffuse>
          </material>
        </visual>

        <collision name="round_pillar_tall_collision">
          <pose>-7 -7 1.5 0 0 0</pose>
          <geometry><cylinder><radius>0.75</radius><length>3</length></cylinder></geometry>
        </collision>
        <visual name="round_pillar_tall_visual">
          <pose>-7 -7 1.5 0 0 0</pose>
          <geometry><cylinder><radius>0.75</radius><length>3</length></cylinder></geometry>
          <material>
            <ambient>0.20 0.38 0.28 1</ambient>
            <diffuse>0.28 0.65 0.42 1</diffuse>
          </material>
        </visual>

        <collision name="round_pillar_short_collision">
          <pose>-3 10 1 0 0 0</pose>
          <geometry><cylinder><radius>0.6</radius><length>2</length></cylinder></geometry>
        </collision>
        <visual name="round_pillar_short_visual">
          <pose>-3 10 1 0 0 0</pose>
          <geometry><cylinder><radius>0.6</radius><length>2</length></cylinder></geometry>
          <material>
            <ambient>0.26 0.24 0.45 1</ambient>
            <diffuse>0.40 0.38 0.72 1</diffuse>
          </material>
        </visual>

        <collision name="stacked_box_base_collision">
          <pose>10 -10 0.5 0 0 0</pose>
          <geometry><box><size>2.4 2.4 1</size></box></geometry>
        </collision>
        <visual name="stacked_box_base_visual">
          <pose>10 -10 0.5 0 0 0</pose>
          <geometry><box><size>2.4 2.4 1</size></box></geometry>
          <material>
            <ambient>0.38 0.30 0.16 1</ambient>
            <diffuse>0.62 0.48 0.24 1</diffuse>
          </material>
        </visual>

        <collision name="stacked_box_top_collision">
          <pose>10 -10 1.75 0 0 0.35</pose>
          <geometry><box><size>1.4 1.4 1.5</size></box></geometry>
        </collision>
        <visual name="stacked_box_top_visual">
          <pose>10 -10 1.75 0 0 0.35</pose>
          <geometry><box><size>1.4 1.4 1.5</size></box></geometry>
          <material>
            <ambient>0.48 0.36 0.16 1</ambient>
            <diffuse>0.74 0.56 0.24 1</diffuse>
          </material>
        </visual>

        <!-- Visual-only landing marker; it cannot collide with the X500. -->
        <visual name="landing_marker_visual">
          <pose>0 0 0.015 0 0 0</pose>
          <geometry><cylinder><radius>1.5</radius><length>0.02</length></cylinder></geometry>
          <material>
            <ambient>0.12 0.38 0.18 1</ambient>
            <diffuse>0.18 0.72 0.30 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <light name="sunUTC" type="directional">
      <pose>0 0 500 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <intensity>1</intensity>
      <direction>0.001 0.625 -0.78</direction>
      <diffuse>0.904 0.904 0.904 1</diffuse>
      <specular>0.271 0.271 0.271 1</specular>
      <attenuation>
        <range>2000</range>
        <linear>0</linear>
        <constant>1</constant>
        <quadratic>0</quadratic>
      </attenuation>
    </light>

    <!-- Match PX4's default simulated geographic origin and ENU world frame. -->
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>47.397971057728974</latitude_deg>
      <longitude_deg>8.546163739800146</longitude_deg>
      <elevation>0</elevation>
    </spherical_coordinates>
  </world>
</sdf>
